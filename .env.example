# Copy to web/.env.local:  cp .env.example web/.env.local

# ---- AI (only needed to generate NEW songs; the two seed songs play without them) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Needs a plan with Eleven Music API access
ELEVENLABS_API_KEY=

# ---- Arc testnet (prefilled with our deployed contract; no changes needed) ----
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_SONGSTUDY_MARKET_ADDRESS=0x5F7e6da30480Fc92190d17b3F51C7559c9F04A0F
# Block the market was deployed in; the class library scans events from here
NEXT_PUBLIC_SONGSTUDY_MARKET_DEPLOY_BLOCK=73102727
# Optional: adds mobile/QR wallets via WalletConnect. Browser wallets (MetaMask) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
