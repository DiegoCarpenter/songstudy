  "factMap": [
    {
      "fact": "OLS chooses beta_0 hat and beta_1 hat to minimize the sum of squared residuals.",
      "lyricLine": "Minimize the sum of squared residuals"
    },
    {
      "fact": "The slope estimate is beta_1 hat = Cov(x, y) / Var(x).",
      "lyricLine": "Slope is covariance over variance"
    },
    {
      "fact": "The intercept estimate is beta_0 hat = y bar - beta_1 hat * x bar.",
      "lyricLine": "Intercept is y bar minus slope times x bar"
    },
    {
      "fact": "The OLS regression line always passes through the point (x bar, y bar).",
      "lyricLine": "The line always runs through x bar, y bar"
    },
    {
      "fact": "Residuals sum to zero and are uncorrelated with x.",
      "lyricLine": "Residuals sum to zero, uncorrelated with x"
    },
    {
      "fact": "R-squared = explained sum of squares / total sum of squares.",
      "lyricLine": "R squared is explained over total sum of squares"
    },
    {
      "fact": "R-squared is between 0 and 1 and measures fit, not causality.",
      "lyricLine": "It sits between zero and one, fit not causality"
    },
    {
      "fact": "Zero conditional mean, E[u | x] = 0 (exogeneity), is the key assumption for unbiasedness.",
      "lyricLine": "Zero conditional mean keeps beta unbiased"
    },
    {
      "fact": "If zero conditional mean fails, we have omitted variable bias.",
      "lyricLine": "If it fails, omitted variable bias"
    },
    {
      "fact": "Homoskedasticity means Var(u | x) is constant.",
      "lyricLine": "Constant variance of u is homoskedasticity"
    },
    {
      "fact": "Homoskedasticity is needed for the usual standard errors, not for unbiasedness.",
      "lyricLine": "Needed for standard errors, not unbiasedness"
    }
  ],
